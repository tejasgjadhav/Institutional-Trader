<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sayali.cas-calc</string>

  <!-- Calculated Constituents live server — runs all day, restarts if it dies.
       UI: http://localhost:8787 (the "CAS Calculator" app opens it). -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/arch</string>
    <string>-arm64</string>
    <string>/Users/sayali/files/institutional-trader/.venv/bin/python</string>
    <string>/Users/sayali/files/institutional-trader/studies/CAS_NIFTY_SENSEX_DATA/live_calc_server.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/sayali/files/institutional-trader</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/sayali/files/institutional-trader/logs/cas_calc_server.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sayali/files/institutional-trader/logs/cas_calc_server.err.log</string>
</dict>
</plist>
